# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.
# Each team member keeps their own .env locally with their own API key.
# (Sharing one free-tier key across three people will hit rate limits.)

# Gemini API key — used by agents.py to call the Gemini generative AI API.
# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
